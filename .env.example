# NYC Open Data credentials - https://data.cityofnewyork.us → Developer Settings
# Use an API key pair (preferred) or an app token; the key pair wins if both are set.
NYC_API_KEY_ID=put_key_id_here
NYC_API_KEY_SECRET=put_key_secret_here
NYC_APP_TOKEN=

BATCH_SIZE=100
BATCH_DELAY_SECONDS=14400
REFRESH_INTERVAL_SECONDS=86400

DB_HOST=db
DB_PORT=3306
DB_NAME=devdb
DB_USER=dev
DB_PASSWORD=put_password_here
DB_ROOT_PASSWORD=put_root_password_here
